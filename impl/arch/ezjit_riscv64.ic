#include <stdint.h>
#include <limits.h>

// <riscv64>
/*
// ubranch target <imm20> has the range of +/- 1MB because of the x2 bias
// cbranch target <imm12> has the range of +/- 4KB because of the x2 bias
// ubranch target <imm12> has the range of +/- 2KB because of no bias

riscv64 instructions:
Hex                              Instr                         Size
FF 01 01 13                      addi sp, sp, -16              4
00 11 34 23                      sd   ra, 8(sp)                4
00 81 30 23                      sd   fp, 0(sp)                4
01 01 04 13                      addi fp, sp, 16               4

// addi sp, sp, -16
01   21 30 23                    sd s2, 0(sp)                  4
(11-0)9 35 03                    ld a0, <imm12>(s2)            4
00   01 39 03                    ld s2, 0(sp)                  4
// addi sp, sp, 16

(20)(10-1)(11)(19-12) EF         jal ra,   <imm20>             4
(20)(10-1)(11)(19-12) 6F         jal zero, <imm20>             4 ; j <imm20>

(11-0)5 00 E7                    jalr ra,   <imm12>(a0)        4
(11-0)5 00 67                    jalr zero, <imm12>(a0)        4 ; jr <imm12>

(31-12)  05 17                   auipc a0, <imm20>             4
(31-12)  05 37                   lui   a0, <imm20>             4
(11-0) 5 05 13                   addi  a0, a0, <imm12>         4
00 C5 15 13                      slli  a0, a0, 12              4

(12)(10-5)b0 05 h1(4-1)(11)63    bnez  a0, <imm12>             4
(12)(10-5)b0 05 h0(4-1)(11)63    beqz  a0, <imm12>             4

00 81 30 83                      ld   ra,   8(sp)              4
00 01 34 03                      ld   fp,   0(sp)              4
01 01 01 13                      addi sp,   sp, 16             4
00 00 80 67                      jalr zero, 0(ra)              4 ; ret

plc_a0_<imm52> (place constant) is:
lui_a0_<imm20>
addi_a0_a0_<imm12>
slli_a0_a0_12
addi_a0_a0_<imm12>
slli_a0_a0_12
addi_a0_a0_<imm12>
slli_a0_a0_12

plc_s2_<imm52> (place constant) is:
lui_s2_<imm20>
addi_s2_s2_<imm12>
slli_s2_s2_12
addi_s2_s2_<imm12>
slli_s2_s2_12
addi_s2_s2_<imm12>
slli_s2_s2_12

