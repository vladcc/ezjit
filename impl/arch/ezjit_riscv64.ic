typedef uint64_t uptr;
typedef int64_t iptr;

// <private-to-arch>
#define SZ_ADDI_SP_SP_N16   4
#define SZ_SD_RA_8_SP       4
#define SZ_SD_FP_0_SP       4
#define SZ_ADDI_FP_SP_16    4
#define SZ_SD_S2_0_SP       4
#define SZ_LD_A0_IMM12_S2   4
#define SZ_LD_S2_0_SP       4
#define SZ_JAL_RA_IMM20     4
#define SZ_JAL_ZERO_IMM20   4
#define SZ_JALR_RA_IMM12_A0 4
#define SZ_JALR_ZERO_IMM12  4
#define SZ_AUIPC_A0_IMM20   4
#define SZ_LUI_A0_IMM20     4
#define SZ_ADDI_A0_A0_IMM12 4
#define SZ_SLLI_A0_A0_12    4
#define SZ_LUI_S2_IMM20     4
#define SZ_ADDI_S2_S2_IMM12 4
#define SZ_SLLI_S2_S2_12    4
#define SZ_BNEZ_A0_IMM12    4
#define SZ_BEQZ_A0_IMM12    4
#define SZ_LD_RA_8_SP       4
#define SZ_LD_FP_0_SP       4
#define SZ_ADDI_SP_SP_16    4
#define SZ_JALR_ZERO_0_RA   4 // ret
#define SZ_PLC_A0_IMM52     \
(SZ_LUI_A0_IMM20 + (SZ_ADDI_A0_A0_IMM12 * 3) + (SZ_SLLI_A0_A0_12 * 3))
#define SZ_PLC_S2_IMM52     \
(SZ_LUI_S2_IMM20 + (SZ_ADDI_S2_S2_IMM12 * 4) + (SZ_SLLI_S2_S2_12 * 3))

#define SZ_PUSH_FRAME       \
(SZ_ADDI_SP_SP_N16 + SZ_SD_RA_8_SP + SZ_SD_FP_0_SP + SZ_ADDI_FP_SP_16)
#define SZ_POP_FRAME        \
(SZ_LD_RA_8_SP + SZ_LD_FP_0_SP + SZ_ADDI_SP_SP_16 + SZ_JALR_ZERO_0_RA)

#define STK_FRAME_XTRA      \
(SZ_PUSH_FRAME + SZ_ADDI_SP_SP_N16 + SZ_SD_S2_0_SP + SZ_LD_S2_0_SP \
+ SZ_ADDI_FP_SP_16 + SZ_POP_FRAME)

#define MAX_INSTR_SIZE      44

#define FN_TBL_OFFS_BIAS    2048
// </private-to-arch>

// <public-to-ezjit.c>
#define RESERVE_EXTRA     256 // extra bytes in code buffer

#define SZ_SET_FN_TBL_PTR (SZ_ADDI_SP_SP_N16 + SZ_SD_S2_0_SP + SZ_PLC_S2_IMM52)
#define TBL_PTR_OFFS      (SZ_PUSH_FRAME + SZ_ADDI_SP_SP_N16 + SZ_SD_S2_0_SP)
#define CODE_START        (SZ_PUSH_FRAME + SZ_SET_FN_TBL_PTR)

#define SZ_CALL_TARGET    SZ_PUSH_FRAME

#define SZ_INSTR_FN_CALL_NEAR SZ_JAL_RA_IMM20
#define SZ_INSTR_FN_CALL_FAR  (SZ_AUIPC_A0_IMM20 + SZ_JALR_RA_IMM12_A0)
#define SZ_INSTR_FN_CALL_ABS  (SZ_LD_A0_IMM12_S2 + SZ_JALR_RA_IMM12_A0)

#define SZ_UJMP_POST_NEAR SZ_JAL_ZERO_IMM20
#define SZ_UJMP_POST_FAR  (SZ_AUIPC_A0_IMM20 + SZ_JALR_ZERO_IMM12)
#define SZ_UJMP_POST_ABS  (SZ_PLC_A0_IMM52 + SZ_JALR_ZERO_IMM12)

#define SZ_CJMP_POST_NEAR SZ_BNEZ_A0_IMM12
#define SZ_CJMP_POST_FAR  (SZ_BEQZ_A0_IMM12 + SZ_JAL_ZERO_IMM20)
#define SZ_CJMP_POST_ABS  \
(SZ_BEQZ_A0_IMM12 + SZ_PLC_A0_IMM52 + SZ_JALR_ZERO_IMM12)

#define SZ_CALL_POST_NEAR SZ_JAL_RA_IMM20
#define SZ_CALL_POST_FAR  (SZ_AUIPC_A0_IMM20 + SZ_JALR_RA_IMM12_A0)
#define SZ_CALL_POST_ABS  (SZ_PLC_A0_IMM52 + SZ_JALR_RA_IMM12_A0)

#define SZ_RET_POST       SZ_POP_FRAME
#define SZ_FINISH_POST    (SZ_LD_S2_0_SP + SZ_ADDI_SP_SP_16 + SZ_POP_FRAME)

#define AVG_INSTR_SZ      29
// </public-to-ezjit.c>

// <offs>
static inline iptr arch_get_offs(uptr dest, uptr src)
{
	return (iptr)(dest - src);
}

static inline bool arch_is_in_range_2gb(iptr dist)
{
#define MINUS_2GB (-2147483648)
#define PLUS_2GB  2147483647
    return (dist >= MINUS_2GB && dist <= PLUS_2GB);
#undef MINUS_2GB
#undef PLUS_2GB
}
static inline bool arch_is_in_range_imm20_x2(iptr dist)
{
#define MINUS_1MB (-1048576)
#define PLUS_1MB  1048574
    return (dist >= MINUS_1MB && dist <= PLUS_1MB);
#undef MINUS_1MB
#undef PLUS_1MB
}
static inline bool arch_is_in_range_imm12_x2(iptr dist)
{
#define MINUS_4KB (-4096)
#define PLUS_4KB  4094
    return (dist >= MINUS_4KB && dist <= PLUS_4KB);
#undef MINUS_4KB
#undef PLUS_4KB
}
static inline bool arch_is_in_range_imm12(iptr dist)
{
#define MINUS_2KB (-2048)
#define PLUS_2KB  2047
    return (dist >= MINUS_2KB && dist <= PLUS_2KB);
#undef MINUS_2KB
#undef PLUS_2KB
}

static inline bool arch_is_in_range_call_near(iptr dist)
{
    return arch_is_in_range_imm20_x2(dist);
}
static inline bool arch_is_in_range_call_far(iptr dist)
{
    return arch_is_in_range_2gb(dist);
}

static inline bool arch_is_in_range_ujmp_near(iptr offs)
{
    return arch_is_in_range_imm20_x2(offs);
}
static inline bool arch_is_in_range_ujmp_far(iptr offs)
{
    return arch_is_in_range_2gb(offs);
}

static inline bool arch_is_in_range_cjmp_near(iptr offs)
{
    return arch_is_in_range_imm20_x2(offs);
}
static inline bool arch_is_in_range_cjmp_far(iptr offs)
{
    return arch_is_in_range_2gb(offs);
}
// </offs>

// <write>
static inline void arch_write_instr(code_buff * cb, uint32_t instr)
{
    *(uint32_t *)(cb->buff + cb->pos) = instr;
    cb->pos += sizeof(instr);
}
// </write>
// <emit>
static inline void arch_emit_push_s2(code_buff * cb)
{
	// addi sp, sp, -16
	arch_write_instr(cb, 0xFF010113);
	// sd s2, 0(sp)
	arch_write_instr(cb, 0x01213023);
}

static inline void arch_emit_pop_s2(code_buff * cb)
{
	// ld s2, 0(sp)
	arch_write_instr(cb, 0x00013903);
	// addi sp, sp, 16
	arch_write_instr(cb, 0x01010113);
}

static inline void arch_emit_fn_enter(code_buff * cb)
{
	// addi sp, sp, -16
	arch_write_instr(cb, 0xFF010113);
	// sd ra, 8(sp)
	arch_write_instr(cb, 0x00113423);
	// sd fp, 0(sp)
	arch_write_instr(cb, 0x00813023);
	// addi fp, sp, 16
	arch_write_instr(cb, 0x01010413);
}

static inline void arch_emit_ld_a0_imm12_s2(code_buff * cb, uint32_t imm12)
{
	// ld a0, <imm12>(s2)
	arch_write_instr(cb, 0x00093503 | ((imm12 << 20) & 0xFFF00000));
}

static inline uint32_t instr_jal_imm20(uint32_t imm21)
{
	uint32_t b20    = (imm21 & 0x00100000) >> 20;
	uint32_t b10_1  = (imm21 & 0x000007FE) >> 1;
	uint32_t b11    = (imm21 & 0x00000800) >> 11;
	uint32_t b19_12 = (imm21 & 0x000FF000) >> 12;
	return ((b20 << 31) | (b10_1 << 21) | (b11 << 20) | (b19_12 << 12));
}
static inline void arch_emit_jal_ra_imm20(code_buff * cb, int32_t imm21)
{
	// jal ra, <imm20>
	arch_write_instr(cb, instr_jal_imm20((uint32_t)imm21) | 0x000000EF);
}
static inline void arch_emit_jal_zero_imm20(code_buff * cb, int32_t imm20)
{
	// jal zero, <imm20>
	arch_write_instr(cb, instr_jal_imm20((uint32_t)imm20) | 0x0000006F);
}

static inline void arch_emit_jalr_ra_imm12_a0(code_buff * cb, int32_t imm12)
{
	// jalr ra, <imm12>(a0)
	arch_write_instr(cb, 0x000500E7 | (uint32_t)(imm12 << 20));
}
static inline void arch_emit_jalr_zero_imm12_a0(code_buff * cb, int32_t imm12)
{
	// jalr zero, <imm12>(a0)
	arch_write_instr(cb, 0x00050067 | (uint32_t)(imm12 << 20));
}

static inline void arch_emit_auipc_a0_imm20(code_buff * cb, uint32_t imm20)
{
	// auipc a0, <imm20>
	arch_write_instr(cb, 0x00000517 | (imm20 << 12));
}

static inline void arch_emit_plc_a0_imm52(code_buff * cb, uint64_t imm52)
{
	uint64_t imm64 = imm52;
	uint32_t b11_0  = imm64 & 0x0FFFull;

	imm64 = (imm64 >> 12) + ((b11_0  & 0x00000800) >> 11);
	uint32_t b23_12 = (uint32_t)(imm64 & 0x0FFFull);

	imm64 = (imm64 >> 12) + ((b23_12 & 0x00000800) >> 11);
	uint32_t b35_24 = (uint32_t)(imm64 & 0x0FFFull);

	imm64 = (imm64 >> 12) + ((b35_24 & 0x00000800) >> 11);
	uint32_t b47_36 = (uint32_t)(imm64 & 0x0FFFull);

	imm64 = (imm64 >> 12) + ((b47_36 & 0x00000800) >> 11);
	uint32_t b63_48 = (uint32_t)(imm64 & 0x00FFFFull);

	// lui a0, <imm20>
	arch_write_instr(cb, 0x00000537 | (b63_48 << 12));

	// addi a0, a0, <imm12>
	arch_write_instr(cb, 0x00050513 | (b47_36 << 20));

	// slli a0, a0, 12
	arch_write_instr(cb, 0x00C51513);
	// addi a0, a0, <imm12>
	arch_write_instr(cb, 0x00050513 | (b35_24 << 20));

	// slli a0, a0, 12
	arch_write_instr(cb, 0x00C51513);
	// addi a0, a0, <imm12>
	arch_write_instr(cb, 0x00050513 | (b23_12 << 20));

	// slli a0, a0, 12
	arch_write_instr(cb, 0x00C51513);
	// bits 11-0 come from jalr
}

static inline void arch_emit_plc_s2_imm52(code_buff * cb, uint64_t imm52)
{
	uint64_t imm64 = imm52;
	uint32_t b11_0  = imm64 & 0x0FFFull;

	imm64 = (imm64 >> 12) + ((b11_0  & 0x00000800) >> 11);
	uint32_t b23_12 = (uint32_t)(imm64 & 0x0FFFull);

	imm64 = (imm64 >> 12) + ((b23_12 & 0x00000800) >> 11);
	uint32_t b35_24 = (uint32_t)(imm64 & 0x0FFFull);

	imm64 = (imm64 >> 12) + ((b35_24 & 0x00000800) >> 11);
	uint32_t b47_36 = (uint32_t)(imm64 & 0x0FFFull);

	imm64 = (imm64 >> 12) + ((b47_36 & 0x00000800) >> 11);
	uint32_t b63_48 = (uint32_t)(imm64 & 0x00FFFFull);

	// lui s2, <imm20>
	arch_write_instr(cb, 0x00000937 | (b63_48 << 12));

	// addi s2, s2, <imm12>
	arch_write_instr(cb, 0x00090913 | (b47_36 << 20));

	// slli s2, s2, 12
	arch_write_instr(cb, 0x00C91913);
	// addi s2, s2, <imm12>
	arch_write_instr(cb, 0x00090913 | (b35_24 << 20));

	// slli s2, s2, 12
	arch_write_instr(cb, 0x00C91913);
	// addi s2, s2, <imm12>
	arch_write_instr(cb, 0x00090913 | (b23_12 << 20));

	// slli s2, s2, 12
	arch_write_instr(cb, 0x00C91913);
	// addi s2, s2, <imm12>
	arch_write_instr(cb, 0x00090913 | (b11_0  << 20));
}

static uint32_t branch_imm12(uint32_t imm12)
{
	uint32_t b12   = (imm12 & 0x00001000) >> 12;
	uint32_t b10_5 = (imm12 & 0x000007E0) >> 5;
	uint32_t b4_1  = (imm12 & 0x0000001E) >> 1;
	uint32_t b11   = (imm12 & 0x00000800) >> 11;
	return ((b12 << 31) | (b10_5 << 25) | (b4_1 << 8) | (b11 << 7));
}
static inline void arch_emit_bnez_a0_imm12(code_buff * cb, uint32_t imm12)
{
	// bnez a0, <imm12>
	arch_write_instr(cb, branch_imm12(imm12) | 0x00051063);
}
static inline void arch_emit_beqz_a0_imm12(code_buff * cb, uint32_t imm12)
{
	// beqz a0, <imm12>
	arch_write_instr(cb, branch_imm12(imm12) | 0x00050063);
}

static inline void arch_emit_fn_leave(code_buff * cb)
{
	// ld ra, 8(sp)
	arch_write_instr(cb, 0x00813083);
	// ld fp, 0(sp)
	arch_write_instr(cb, 0x00013403);
	// addi sp, sp, 16
	arch_write_instr(cb, 0x01010113);
	// jalr zero, 0(ra)
	arch_write_instr(cb, 0x00008067);
}
// </emit>

static void arch_cmpl_begin(code_buff * cb)
{
	arch_emit_fn_enter(cb);
	arch_emit_push_s2(cb);
	arch_emit_plc_s2_imm52(cb, 0);
}

static void arch_cmpl_call_tgt(code_buff * cb)
{
	arch_emit_fn_enter(cb);
}

static void arch_cmpl_instr_fn_call(
	code_buff * cb,
	const ezj_ir_instr * instr,
	const ezj_fn_tbl * fn_tbl
)
{
	uint fn_tbl_entry = pezj_instr_get_fn_tbl_entry(instr);
	uptr fn_addr = (uptr)pezj_fn_tbl_get_entry(fn_tbl, fn_tbl_entry);
    byte call_bmag = pezj_instr_get_bmag_disc_instr_fn_call(instr);
	uptr src = (uptr)(cb->buff + pezj_instr_get_fn_call_offset(instr));
	iptr offs = arch_get_offs(fn_addr, src);

    if (PEZJ_BMAG_NEAR == call_bmag)
    {
		arch_emit_jal_ra_imm20(cb, (int32_t)offs);
    }
    else if (PEZJ_BMAG_FAR == call_bmag)
    {
		uint32_t offs32 = (uint32_t)offs;
		uint32_t lo12 = offs32 & 0x00000FFE;
		uint32_t hi20 = (offs32 >> 12) + ((lo12 & 0x00000800) >> 11);

		arch_emit_auipc_a0_imm20(cb, hi20);
		arch_emit_jalr_ra_imm12_a0(cb, (int32_t)lo12);
    }
    else
    {
		arch_emit_ld_a0_imm12_s2(
			cb,
			(fn_tbl_entry * sizeof(ezj_void_fn) - FN_TBL_OFFS_BIAS)
		);
		arch_emit_jalr_ra_imm12_a0(cb, 0);
    }
}

static void arch_cmpl_ujmp(code_buff * cb, const ezj_ir_instr * instr)
{
	uptr dest = pezj_instr_get_offs_of_target(instr);
	uptr src = pezj_instr_get_post_branch_offset(instr);
	iptr offs = arch_get_offs(dest, src);
	byte jmp_bmag = pezj_instr_get_bmag_disc_post_call_branch(instr);

    if (PEZJ_BMAG_NEAR == jmp_bmag)
    {
		arch_emit_jal_zero_imm20(cb, (int32_t)offs);
    }
    else if (PEZJ_BMAG_FAR == jmp_bmag)
    {

		uint32_t offs32 = (uint32_t)offs;
		uint32_t lo12 = offs32 & 0x00000FFE;
		uint32_t hi20 = (offs32 >> 12) + ((lo12 & 0x00000800) >> 11);

		arch_emit_auipc_a0_imm20(cb, hi20);
		arch_emit_jalr_zero_imm12_a0(cb, (int32_t)lo12);
    }
    else
    {
		dest += (uptr)cb->buff;
		arch_emit_plc_a0_imm52(cb, (uint64_t)dest);
		arch_emit_jalr_zero_imm12_a0(
			cb,
			(int32_t)((uint32_t)dest & 0x00000FFE)
		);
    }
}

static void arch_cmpl_cjmp(code_buff * cb, const ezj_ir_instr * instr)
{
	uptr dest = pezj_instr_get_offs_of_target(instr);
	uptr src = pezj_instr_get_post_branch_offset(instr);
	iptr offs = arch_get_offs(dest, src);
	byte jmp_bmag = pezj_instr_get_bmag_disc_post_call_branch(instr);

    if (PEZJ_BMAG_NEAR == jmp_bmag)
    {
		arch_emit_bnez_a0_imm12(cb, (int32_t)((uint32_t)offs & 0x00000FFE));
    }
    else if (PEZJ_BMAG_FAR == jmp_bmag)
    {
#define JUMP_OVER (SZ_BEQZ_A0_IMM12 + SZ_JAL_ZERO_IMM20)
		arch_emit_beqz_a0_imm12(cb, JUMP_OVER);
#undef JUMP_OVER

		offs -= SZ_BEQZ_A0_IMM12;
		arch_emit_jal_zero_imm20(cb, (int32_t)offs);
    }
    else
    {
#define JUMP_OVER (SZ_BEQZ_A0_IMM12 + SZ_PLC_A0_IMM52 + SZ_JAL_ZERO_IMM20)
		arch_emit_beqz_a0_imm12(cb, JUMP_OVER);
#undef JUMP_OVER

		dest += (uptr)cb->buff;
		arch_emit_plc_a0_imm52(cb, (uint64_t)dest);
		arch_emit_jalr_zero_imm12_a0(
			cb,
			(int32_t)((uint32_t)dest & 0x00000FFE)
		);
    }
}

static void arch_cmpl_call(code_buff * cb, const ezj_ir_instr * instr)
{
	uptr dest = pezj_instr_get_offs_of_target(instr);
	uptr src = pezj_instr_get_post_branch_offset(instr);
	iptr offs = arch_get_offs(dest, src);
	byte call_bmag = pezj_instr_get_bmag_disc_post_call_branch(instr);

    if (PEZJ_BMAG_NEAR == call_bmag)
    {
		arch_emit_jal_ra_imm20(cb, (int32_t)offs);
    }
    else if (PEZJ_BMAG_FAR == call_bmag)
    {
		uint32_t offs32 = (uint32_t)offs;
		uint32_t lo12 = offs32 & 0x00000FFE;
		uint32_t hi20 = (offs32 >> 12) + ((lo12 & 0x00000800) >> 11);

		arch_emit_auipc_a0_imm20(cb, hi20);
		arch_emit_jalr_ra_imm12_a0(cb, (int32_t)lo12);
    }
    else
    {
		dest += (uptr)cb->buff;
		arch_emit_plc_a0_imm52(cb, (uint64_t)dest);
		arch_emit_jalr_ra_imm12_a0(
			cb,
			(int32_t)((uint32_t)dest & 0x00000FFE)
		);
    }
}

static void arch_cmpl_ret(code_buff * cb)
{
	arch_emit_fn_leave(cb);
}

static void arch_cmpl_finish(code_buff * cb)
{
	arch_emit_pop_s2(cb);
	arch_emit_fn_leave(cb);
}

static void arch_cmpl_fn_tbl_ptr(code_buff * cb, uptr fn_tbl_addr)
{
	arch_emit_plc_s2_imm52(cb, fn_tbl_addr + FN_TBL_OFFS_BIAS);
}
// </riscv64>

