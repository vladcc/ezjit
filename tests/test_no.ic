static bool test_no(void)
{
	check(1 == ezj_major_ver());
	check(0 == ezj_minor_ver());

	check(false == ezj_is_available());
	check(0 == ezj_code_buff_size(777));
	check(0 == ezj_compile(NULL, NULL, NULL));
	ezj_emit(NULL, NULL, NULL);
	check(EZJ_EC_NONE == ezj_err(NULL, NULL, NULL));
	return true;
}

static ftest tests[] = {
	test_no,
};
