static const byte * code_near_near(int * out_size)
{
	static const uint32_t bin[] = {
		0xa9bf7bfd, // stp x29, x30, [sp, #-0x10]!
		0x910003fd, // mov x29, sp
		0xf81f0ff3, // str x19, [sp, #-0x10]!
		0xd2800013, // mov x19, #0
		0xf2a00013, // movk x19, #0, lsl #16
		0xf2c00013, // movk x19, #0, lsl #32
		0xf2e00013, // movk x19, #0, lsl #48
		0x97fffffb, // bl 8
		0x97fffffa, // bl 8
		0x97fffff7, // bl 0
		0x94000006, // bl 0x40
		0x97fffff6, // bl 4
		0x97fffff6, // bl 8
		0xf84107f3, // ldr x19, [sp], #0x10
		0xa8c17bfd, // ldp x29, x30, [sp], #0x10
		0xd65f03c0, // ret
		0xa9bf7bfd, // stp x29, x30, [sp, #-0x10]!
		0x910003fd, // mov x29, sp
		0x97ffffef, // bl 4
		0x97ffffed, // bl 0
		0x6a00001f, // tst w0, w0
		0x54000081, // b.ne 0x64
		0x97ffffea, // bl 0
		0x97ffffea, // bl 4
		0x17fffffb, // b 0x4c
		0x97ffffe8, // bl 4
		0x97ffffe7, // bl 4
		0x97ffffe7, // bl 8
		0xa8c17bfd, // ldp x29, x30, [sp], #0x10
		0xd65f03c0, // ret
	};

	*out_size = sizeof(bin);
	return (byte *)bin;
}

