// </mod-bmags>

// <compile>
static entry_point compile(
	const ezj_fn_tbl * fn_tbl,
	int * out_code_len,
	mod_bmags mod
)
{
	vm_init();
	ezj_ir * ir = vm_compile_ir(vm_get_code());

	if (mod)
		mod(ir);

	code_buff * cbf = get_rw();
	size_t code_buff_sz = ezj_code_buff_size(pezj_ir_get_len(ir));
	if (cbf->size < code_buff_sz)
		err_quit("code buffer too small");

	if ((*out_code_len = ezj_compile(ir, fn_tbl, cbf->code)))
	{
		ezj_emit(ir, fn_tbl, cbf->code);
		make_rx(cbf->code, cbf->size);
		return (entry_point)((void *)cbf->code);
	}
	return NULL;
}
// </compile>
