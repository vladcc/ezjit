#define OFFS_FAR_POP     (6+GB_1)
#define OFFS_FAR_PUSHA   (7+GB_1)
#define OFFS_FAR_PUSHV   (8+GB_1)
#define OFFS_FAR_RET     (9+GB_1)
#define OFFS_FAR_FINISH  (10+GB_1)

	static ezj_fn_tbl_entry fn_arr[INSTR_END];
	const code_buff * cb = get_static_code_buff();
	const byte * code_addr = cb->code;

	fn_arr[0].void_fn = (ezj_void_fn)(code_addr + OFFS_FAR_ADDVVV);
	fn_arr[1].bool_fn = (ezj_bool_fn)(code_addr + OFFS_FAR_BGEQVV);
	fn_arr[2].void_fn = (ezj_void_fn)(code_addr + OFFS_FAR_CALL);
	fn_arr[3].void_fn = (ezj_void_fn)(code_addr + OFFS_FAR_JMP);
	fn_arr[4].void_fn = (ezj_void_fn)(code_addr + OFFS_FAR_MOVRV);
	fn_arr[5].void_fn = (ezj_void_fn)(code_addr + OFFS_FAR_POP);
	fn_arr[6].void_fn = (ezj_void_fn)(code_addr + OFFS_FAR_PUSHA);
	fn_arr[7].void_fn = (ezj_void_fn)(code_addr + OFFS_FAR_PUSHV);
	fn_arr[8].void_fn = (ezj_void_fn)(code_addr + OFFS_FAR_RET);
	fn_arr[9].void_fn = (ezj_void_fn)(code_addr + OFFS_FAR_FINISH);

	ezj_fn_tbl fn_tbl = {
		(ezj_fn_tbl_entry *)fn_arr,
		sizeof(fn_arr)/sizeof(*fn_arr)
	};

	return fn_tbl;

#undef GB_1
#undef OFFS_FAR_ADDVVV
#undef OFFS_FAR_BGEQVV
#undef OFFS_FAR_CALL
#undef OFFS_FAR_JMP
#undef OFFS_FAR_MOVRV
#undef OFFS_FAR_POP
#undef OFFS_FAR_PUSHA
#undef OFFS_FAR_PUSHV
#undef OFFS_FAR_RET
#undef OFFS_FAR_FINISH
}

