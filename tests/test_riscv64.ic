static const byte * code_near_near(int * out_size)
{
	static const uint32_t bin[] = {
		0xff010113, // addi sp, sp, -0x10
		0x00113423, // sd ra, 8(sp)
		0x00813023, // sd s0, 0(sp)
		0x01010413, // addi s0, sp, 0x10
		0xff010113, // addi sp, sp, -0x10
		0x01213023, // sd s2, 0(sp)
		0x00000937, // lui s2, 0
		0x00090913, // mv s2, s2
		0x00c91913, // slli s2, s2, 0xc
		0x00090913, // mv s2, s2
		0x00c91913, // slli s2, s2, 0xc
		0x00090913, // mv s2, s2
		0x00c91913, // slli s2, s2, 0xc
		0x00090913, // mv s2, s2
		0xfd1ff0ef, // jal -0x30
		0xfcdff0ef, // jal -0x34
		0xfc3ff0ef, // jal -0x3e
		0x024000ef, // jal 0x24
		0xfbfff0ef, // jal -0x42
		0xfbfff0ef, // jal -0x42
		0x00013903, // ld s2, 0(sp)
		0x01010113, // addi sp, sp, 0x10
		0x00813083, // ld ra, 8(sp)
		0x00013403, // ld s0, 0(sp)
		0x01010113, // addi sp, sp, 0x10
		0x00008067, // ret
		0xff010113, // addi sp, sp, -0x10
		0x00113423, // sd ra, 8(sp)
		0x00813023, // sd s0, 0(sp)
		0x01010413, // addi s0, sp, 0x10
		0xf8fff0ef, // jal -0x72
		0xf87ff0ef, // jal -0x7a
		0x00051863, // bnez a0, 0x10
		0xf7dff0ef, // jal -0x84
		0xf7dff0ef, // jal -0x84
		0xff1ff06f, // j -0x10
		0xf75ff0ef, // jal -0x8c
		0xf73ff0ef, // jal -0x8e
		0xf71ff0ef, // jal -0x90
		0x00813083, // ld ra, 8(sp)
		0x00013403, // ld s0, 0(sp)
		0x01010113, // addi sp, sp, 0x10
		0x00008067, // ret
	};

	*out_size = sizeof(bin);
	return (byte *)bin;
}

