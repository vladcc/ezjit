#undef OFFS_ABS_CALL
#undef OFFS_ABS_JMP
#undef OFFS_ABS_MOVRV
#undef OFFS_ABS_POP
#undef OFFS_ABS_PUSHA
#undef OFFS_ABS_PUSHV
#undef OFFS_ABS_RET
#undef OFFS_ABS_FINISH
}

static const byte * code_near_near(int * out_size)
{
	static const uint32_t bin[] = {
		0xe92d4800, // push {r11, lr}
		0xe1a0b00d, // mov r11, sp
		0xe52d4004, // str r4, [sp, #-4]!
		0xe3004000, // movw r4, #0
		0xe3404000, // movt r4, #0
		0xebfffffb, // bl 8
		0xebfffffa, // bl 8
		0xebfffff7, // bl 0
		0xeb000005, // bl 0x3c
		0xebfffff6, // bl 4
		0xebfffff6, // bl 8
		0xe49d4004, // pop {r4}
		0xe1a0d00b, // mov sp, r11
		0xe8bd4800, // pop {r11, lr}
		0xe12fff1e, // bx lr
		0xe92d4800, // push {r11, lr}
		0xe1a0b00d, // mov r11, sp
		0xebffffee, // bl 4
		0xebffffec, // bl 0
		0xe1100000, // tst r0, r0
		0x1a000002, // bne 0x60
		0xebffffe9, // bl 0
		0xebffffe9, // bl 4
		0xeafffff9, // b 0x48
		0xebffffe7, // bl 4
		0xebffffe6, // bl 4
		0xebffffe6, // bl 8
		0xe1a0d00b, // mov sp, r11
		0xe8bd4800, // pop {r11, lr}
		0xe12fff1e, // bx lr
	};

	*out_size = sizeof(bin);
	return (byte *)bin;
}

