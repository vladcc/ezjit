		0xeb7bfff7, //  bl 0x1f00000
		0xeb000005, //  bl 0x3c
		0xeb7bfff6, //  bl 0x1f00004
		0xeb7bfff6, //  bl 0x1f00008
		0xe49d4004, //  pop {r4}
		0xe1a0d00b, //  mov sp, r11
