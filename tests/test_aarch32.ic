static bool test_arch_ezj_code_buff_size(void)
{
#define TEST_AVG_ISNTR_SZ  18
#define TEST_TBL_SZ        (EZJ_FN_TBL_MAX_LEN * sizeof(ezj_void_fn))
#define TEST_RESERVE_EXTRA 256

	check(TEST_AVG_ISNTR_SZ*2 + TEST_TBL_SZ + TEST_RESERVE_EXTRA
		== ezj_code_buff_size(1));
	check(TEST_AVG_ISNTR_SZ*2*11 + TEST_TBL_SZ + TEST_RESERVE_EXTRA
		== ezj_code_buff_size(11));
	return true;

#undef TEST_AVG_ISNTR_SZ
#undef TEST_TBL_SZ
#undef TEST_RESERVE_EXTRA
}

static ezj_fn_tbl tbl_near(void)
{
#define OFFS_NEAR_ADDVVV  1
#define OFFS_NEAR_BGEQVV  2
#define OFFS_NEAR_CALL    3
#define OFFS_NEAR_JMP     4
#define OFFS_NEAR_MOVRV   5
#define OFFS_NEAR_POP     6
#define OFFS_NEAR_PUSHA   7
#define OFFS_NEAR_PUSHV   8
#define OFFS_NEAR_RET     9
#define OFFS_NEAR_FINISH  10

	static ezj_fn_tbl_entry fn_arr[INSTR_END];
	const code_buff * cb = get_static_code_buff();
	const byte * code_addr = cb->code;

	fn_arr[0].void_fn = (ezj_void_fn)(code_addr + OFFS_NEAR_ADDVVV);
	fn_arr[1].bool_fn = (ezj_bool_fn)(code_addr + OFFS_NEAR_BGEQVV);
	fn_arr[2].void_fn = (ezj_void_fn)(code_addr + OFFS_NEAR_CALL);
	fn_arr[3].void_fn = (ezj_void_fn)(code_addr + OFFS_NEAR_JMP);
	fn_arr[4].void_fn = (ezj_void_fn)(code_addr + OFFS_NEAR_MOVRV);
	fn_arr[5].void_fn = (ezj_void_fn)(code_addr + OFFS_NEAR_POP);
	fn_arr[6].void_fn = (ezj_void_fn)(code_addr + OFFS_NEAR_PUSHA);
	fn_arr[7].void_fn = (ezj_void_fn)(code_addr + OFFS_NEAR_PUSHV);
	fn_arr[8].void_fn = (ezj_void_fn)(code_addr + OFFS_NEAR_RET);
	fn_arr[9].void_fn = (ezj_void_fn)(code_addr + OFFS_NEAR_FINISH);

	ezj_fn_tbl fn_tbl = {
		(ezj_fn_tbl_entry *)fn_arr,
		sizeof(fn_arr)/sizeof(*fn_arr)
	};

	return fn_tbl;

#undef OFFS_NEAR_ADDVVV
#undef OFFS_NEAR_BGEQVV
#undef OFFS_NEAR_CALL
#undef OFFS_NEAR_JMP
#undef OFFS_NEAR_MOVRV
#undef OFFS_NEAR_POP
#undef OFFS_NEAR_PUSHA
#undef OFFS_NEAR_PUSHV
#undef OFFS_NEAR_RET
#undef OFFS_NEAR_FINISH
}

