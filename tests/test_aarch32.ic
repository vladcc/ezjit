		0xe12fff1e, //  bx lr
		0xe92d4800, //  push {r11, lr}
		0xe1a0b00d, //  mov r11, sp
		0xeb7bffee, //  bl 0x1f00004
		0xeb7bffec, //  bl 0x1f00000
		0xe1100000, //  tst r0, r0
		0x1a000002, //  bne 0x60
		0xeb7bffe9, //  bl 0x1f00000
		0xeb7bffe9, //  bl 0x1f00004
		0xeafffff9, //  b 0x48
		0xeb7bffe7, //  bl 0x1f00004
		0xeb7bffe6, //  bl 0x1f00004
		0xeb7bffe6, //  bl 0x1f00008
		0xe1a0d00b, //  mov sp, r11
		0xe8bd4800, //  pop {r11, lr}
		0xe12fff1e, //  bx lr
	};

	*out_size = sizeof(bin);
	return (byte *)bin;
}

