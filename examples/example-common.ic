typedef unsigned char byte;
typedef unsigned int uint;

static void err_quit(const char * msg)
{
	fprintf(stderr, "%s\n", msg);
	exit(EXIT_FAILURE);
}

// <code-buffer>
typedef struct code_buff {
	byte * code;
	size_t size;
} code_buff;

static code_buff * get_code_buff(void)
{
#define CODE_BUFF_SZ (1024*1024*8)

	static code_buff cbuff = {0};
	static byte code_arr[CODE_BUFF_SZ] = {0};

	int pg_sz = getpagesize();
	int act_sz = CODE_BUFF_SZ;
	int mod = (int)((uintptr_t)code_arr % (unsigned)pg_sz);
	int left_over = 0;
	byte * cptr = code_arr;

	if (mod)
	{
		left_over = pg_sz - mod;
		cptr += left_over;
		act_sz = CODE_BUFF_SZ - pg_sz;
	}

	if (act_sz <= 0)
		return NULL;

	if (mprotect(cptr, (size_t)act_sz, PROT_READ|PROT_WRITE) == -1)
	{
		perror("mprotect");
		return NULL;
	}

	memset(code_arr, 0, sizeof(code_arr));
	cbuff.code = cptr;
	cbuff.size = (size_t)act_sz;

	return &cbuff;

#undef CODE_BUFF_SZ
}
static code_buff * get_rw(void)
{
	return get_code_buff();
}
static void make_rx(void * mem, size_t size)
{
	if (mprotect(mem, size, PROT_READ|PROT_EXEC) == -1)
	{
		perror("mprotect");
		exit(EXIT_FAILURE);
	}
}
// </code-buffer>

// <vm>
typedef enum {
	ADDVVC,    //  0
	ADDVVV,    //  1
	BEQRC,     //  2
	BGRTVV,    //  3
	BGEQVV,    //  4
	BLEQVV,    //  5
	BLTVC,     //  6
	BNEQVC,    //  7
	BEQVC,     //  8
	CALL,      //  9
	FREEV,     //  10
	JMP,       //  11
	LDBVVV,    //  12
	MALLOC,    //  13
	MEMSET,    //  14
	MOVRC,     //  15
	MOVRV,     //  16
	MOVVC,     //  17
	MOVVR,     //  18
	MOVVV,     //  19
	MULVVV,    //  20
	POP,       //  21
	PUSHA,     //  22
	PUSHC,     //  23
	PUSHV,     //  24
	RET,       //  25
	STBVCC,    //  26
	STBVVC,    //  27
	SUBVVC,    //  28
	FINISH,    //  29
	INSTR_END  //  30
} instr_type;

typedef struct vm_instr {
	instr_type type;
	int32_t op_a;
	int32_t op_b;
	int32_t op_c;
	void * ptr; // for direct threaded
} vm_instr;

typedef struct vm_code {
	vm_instr * code;
	size_t size;
} vm_code;

typedef size_t word;

#define VM_STK_SZ 1024

static struct {
	vm_code * code;
	vm_instr * ip;
	word * bp;
	word * sp;
	word rret;
	word stack[VM_STK_SZ];
	bool done;
} vm;

static vm_code * vm_get_code(void)
{
	return vm.code;
}

static inline void * vm_malloc(size_t n)
{
	void * ret = malloc(n+2);
	if (!ret)
	{
		fprintf(stderr, "error: malloc() failed\n");
		exit(EXIT_FAILURE);
	}
	return ret;
}

static inline void vm_mem_init(byte val, byte * mem, size_t sz)
{
	memset(mem, val, (size_t)sz+2);
}

#if defined(NEVER_INLINE)
#define ATTR __attribute__ ((noinline))
#elif defined(ALWAYS_INLINE)
#define ATTR inline __attribute__((always_inline))
#else
#define ATTR inline
#endif

static ATTR void vm_i_addvvc(void)
{
	vm.bp[vm.ip->op_a] = vm.bp[vm.ip->op_b] + vm.ip->op_c;
	++vm.ip;
}
static ATTR void vm_i_addvvv(void)
{
	vm.bp[vm.ip->op_a] = vm.bp[vm.ip->op_b] + vm.bp[vm.ip->op_c];
	++vm.ip;
}
static ATTR bool vm_i_beqrc(void)
{
	bool is_eq = ((int32_t)vm.rret == vm.ip->op_b);
	vm.ip += is_eq ? vm.ip->op_c : 1;
	return is_eq;
}
static ATTR bool vm_i_bgrtvv(void)
{
	bool is_grt = (vm.bp[vm.ip->op_a] > vm.bp[vm.ip->op_b]);
	vm.ip += is_grt ? vm.ip->op_c : 1;
	return is_grt;
}
static ATTR bool vm_i_bgeqvv(void)
{
	bool is_grt = (vm.bp[vm.ip->op_a] >= vm.bp[vm.ip->op_b]);
	vm.ip += is_grt ? vm.ip->op_c : 1;
	return is_grt;
}
static ATTR bool vm_i_bleqvv(void)
{
	bool is_leq = (vm.bp[vm.ip->op_a] <= vm.bp[vm.ip->op_b]);
	vm.ip += is_leq ? vm.ip->op_c : 1;
	return is_leq;
}
static ATTR bool vm_i_bltvc(void)
{
	bool is_lt = ((int32_t)vm.bp[vm.ip->op_a] < vm.ip->op_b);
	vm.ip += is_lt ? vm.ip->op_c : 1;
	return is_lt;
}
static ATTR bool vm_i_beqvc(void)
{
	bool is_eq = ((int32_t)vm.bp[vm.ip->op_a] == vm.ip->op_b);
	vm.ip += is_eq ? vm.ip->op_c : 1;
	return is_eq;
}
static ATTR bool vm_i_bneqvc(void)
{
	bool is_neq = ((int32_t)vm.bp[vm.ip->op_a] != vm.ip->op_b);
	vm.ip += is_neq ? vm.ip->op_c : 1;
	return is_neq;
}
static ATTR void vm_i_call(void)
{
	// call
	++vm.sp;
	*vm.sp = (word)(vm.ip+1);
	vm.ip += vm.ip->op_a;

	// enter
	++vm.sp;
	*vm.sp = (word)vm.bp;
	vm.bp = vm.sp;
}
static ATTR void vm_i_freev(void)
{
	free((void *)vm.bp[vm.ip->op_a]);
	++vm.ip;
}
static ATTR void vm_i_jmp(void)
{
	vm.ip += vm.ip->op_a;
}
static ATTR void vm_i_ldbvvv(void)
{
	byte * p = (byte *)vm.bp[vm.ip->op_b];
	vm.bp[vm.ip->op_a] = p[vm.bp[vm.ip->op_c]];
	++vm.ip;
}
static ATTR void vm_i_malloc(void)
{
	void * p = vm_malloc(vm.bp[vm.ip->op_b]);
	vm.bp[vm.ip->op_a] = (word)p;
	++vm.ip;
}
static ATTR void vm_i_memset(void)
{
	vm_mem_init((int)vm.bp[vm.ip->op_b], (byte *)vm.bp[vm.ip->op_a],
		vm.bp[vm.ip->op_c]);
	++vm.ip;
}
static ATTR void vm_i_movrc(void)
{
	vm.rret = vm.ip->op_b;
	++vm.ip;
}
static ATTR void vm_i_movrv(void)
{
	vm.rret = vm.bp[vm.ip->op_b];
	++vm.ip;
}
static ATTR void vm_i_movvc(void)
{
	vm.bp[vm.ip->op_a] = vm.ip->op_b;
	++vm.ip;
}
static ATTR void vm_i_movvr(void)
{
	vm.bp[vm.ip->op_a] = vm.rret;
	++vm.ip;
}
static ATTR void vm_i_movvv(void)
{
	vm.bp[vm.ip->op_a] = vm.bp[vm.ip->op_b];
	++vm.ip;
}
static ATTR void vm_i_mulvvv(void)
{
	vm.bp[vm.ip->op_a] = vm.bp[vm.ip->op_b] * vm.bp[vm.ip->op_c];
	++vm.ip;
}
static ATTR void vm_i_pop(void)
{
	vm.sp -= vm.ip->op_a;
	++vm.ip;
}
static ATTR void vm_i_pusha(void)
{
	vm.sp += vm.ip->op_a;
	++vm.ip;
}
static ATTR void vm_i_pushc(void)
{
	++vm.sp;
	*vm.sp = vm.ip->op_a;
	++vm.ip;
}
static ATTR void vm_i_pushv(void)
{
	++vm.sp;
	*vm.sp = vm.bp[vm.ip->op_a];
	++vm.ip;
}
static ATTR void vm_i_ret(void)
{
	// leave
	vm.bp = (word *)(*vm.sp);
	--vm.sp;

	// ret
	vm.ip = (vm_instr *)*vm.sp;
	--vm.sp;
}
static ATTR void vm_i_stbvcc(void)
{
	byte * p = (byte *)vm.bp[vm.ip->op_a];
	p[vm.ip->op_b] = vm.ip->op_c;
	++vm.ip;
}
static ATTR void vm_i_stbvvc(void)
{
	byte * p = (byte *)vm.bp[vm.ip->op_a];
	p[vm.bp[vm.ip->op_b]] = vm.ip->op_c;
	++vm.ip;
}
static ATTR void vm_i_subvvc(void)
{
	vm.bp[vm.ip->op_a] = vm.bp[vm.ip->op_b] - vm.ip->op_c;
	++vm.ip;
}
static ATTR void vm_i_finish(void)
{
	vm.done = true;
}

